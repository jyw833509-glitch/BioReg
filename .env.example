# Required. Use .env.local or deployment environment variables; never commit credentials.
# npm run db:local creates an ignored local .env.local if DATABASE_URL is not set there.
DATABASE_URL=
# Example only: postgresql://USER:PASSWORD@HOST:5432/bioreg?sslmode=verify-full
# Optional separate test server. Tests create and remove only their own random schema.
TEST_DATABASE_URL=
# Production defaults to official records only. Explicitly enable mock fixtures only for development previews.
# BIOREG_INCLUDE_MOCK_DATA=true
# Optional fixed browser origin for single-user Watchlist writes behind a proxy.
# APP_ORIGIN=https://your-private-site.example
# Optional ASCII-only path for the native local PostgreSQL cluster on Windows.
# BIOREG_LOCAL_ROOT=C:/Users/YOUR_USER/AppData/Local/BioRegRadar/dev
