generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Agency {
  FDA
  EMA
  NMPA
  CDE
  ICH
  PMDA
}
enum DocumentType {
  FINAL_GUIDANCE
  DRAFT_GUIDANCE
  GUIDELINE
  REVISED_GUIDELINE
  QA
  REFLECTION_PAPER
  CONCEPT_PAPER
  POSITION_PAPER
  RECOMMENDATION
  TECHNICAL_GUIDELINE
  NOTICE
  ANNOUNCEMENT
  REGULATION
  REGULATION_AMENDMENT
  CONSULTATION_DRAFT
  OTHER
}
enum RegulationStatus {
  DRAFT
  FINAL
  EFFECTIVE
  REVISED
  SUPERSEDED
  WITHDRAWN
  UNDER_CONSULTATION
  ARCHIVED
  UNKNOWN
}
enum Importance {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}
enum SyncStatus {
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
}
enum SourceHealth {
  HEALTHY
  DEGRADED
  UNAVAILABLE
  DISABLED
}
model SyncJob {
  id String @id @default(cuid())
  trigger String
  mode String
  status String @default("RUNNING")
  started_at DateTime @default(now()) @db.Timestamptz(3)
  finished_at DateTime? @db.Timestamptz(3)
  summary Json @default("{}")
  logs SyncLog[]
  @@index([started_at(sort: Desc)])
  @@map("sync_jobs")
}
model Source {
  id                String       @id @default(cuid())
  code              Agency       @unique
  name              String
  country_or_region String
  official_base_url String
  enabled           Boolean      @default(true)
  sync_frequency    Int          @default(12) // hours between attempts
  last_sync_at      DateTime?     @db.Timestamptz(3)
  last_success_at   DateTime? @db.Timestamptz(3)
  last_failure_at   DateTime? @db.Timestamptz(3)
  last_status       SourceHealth @default(UNAVAILABLE)
  created_at        DateTime      @default(now()) @db.Timestamptz(3)
  updated_at        DateTime      @updatedAt @db.Timestamptz(3)
  regulations       Regulation[]
  sync_logs         SyncLog[]
  @@unique([id, code])
  @@map("sources")
}
model Regulation {
  id                   String           @id @default(cuid())
  source_id            String
  regulator            Agency
  source               Source           @relation(fields: [source_id, regulator], references: [id, code], onDelete: Restrict)
  country_or_region    String
  title_original       String
  title_zh             String           @default("")
  document_number      String?
  document_type        DocumentType
  status               RegulationStatus @default(UNKNOWN)
  publication_date     DateTime?         @db.Date
  publication_date_raw String?
  issuing_offices      String[]         @default([])
  official_topics      String[]         @default([])
  docket_number        String?
  source_metadata      Json             @default("{}")
  attachment_urls      String[]         @default([])
  effective_date       DateTime?         @db.Date
  updated_date         DateTime?         @db.Date // official update date, never a last-checked timestamp
  official_url         String?
  canonical_url        String?
  pdf_url              String?
  source_page_url      String?
  official_summary     String?
  summary_zh           String           @default("")
  content_text         String           @default("")
  categories           String[]         @default([])
  subcategories        String[]         @default([])
  keywords             String[]         @default([])
  product_types        String[]         @default([])
  development_stages   String[]         @default([])
  affected_departments String[]         @default([])
  importance_level     Importance       @default(MEDIUM)
  version              String           @default("1.0")
  previous_version_id  String?
  previous_version     RegulationVersion? @relation("RegulationPrevious", fields:[previous_version_id],references:[id],onDelete:Restrict)
  is_current_version   Boolean          @default(true)
  is_new               Boolean          @default(true)
  is_updated           Boolean          @default(false)
  content_hash         String?
  source_hash          String?
  first_detected_at    DateTime         @default(now()) @db.Timestamptz(3)
  last_checked_at      DateTime?        @db.Timestamptz(3)
  created_at           DateTime         @default(now()) @db.Timestamptz(3)
  updated_at           DateTime         @updatedAt @db.Timestamptz(3)
  is_mock              Boolean          @default(false)
  versions             RegulationVersion[] @relation("RegulationHistory")
  watchlist_matches WatchlistMatch[]
  notifications NotificationEvent[]
  change_events        ChangeEvent[]
  @@index([regulator])
  @@index([source_id, title_original, publication_date])
  @@index([publication_date(sort: Desc)])
  @@index([status])
  @@index([document_type])
  @@index([importance_level])
  @@index([content_hash])
  @@index([docket_number])
  @@index([canonical_url])
  @@index([first_detected_at])
  @@index([last_checked_at])
  @@index([categories], type: Gin)
  @@index([subcategories], type: Gin)
  @@index([keywords], type: Gin)
  @@index([product_types], type: Gin)
  @@index([development_stages], type: Gin)
  @@index([affected_departments], type: Gin)
  @@map("regulations")
}
model RegulationVersion {
  id                  String           @id @default(cuid())
  regulation_id       String
  regulation          Regulation       @relation("RegulationHistory",fields:[regulation_id],references:[id],onDelete:Restrict)
  version_name        String
  document_url        String?
  pdf_url             String?
  publication_date    DateTime?         @db.Date
  detected_at         DateTime          @default(now()) @db.Timestamptz(3)
  status              RegulationStatus
  content_hash        String?
  source_hash         String?
  content_snapshot    String
  previous_version_id String?
  previous_version    RegulationVersion? @relation("VersionChain",fields:[previous_version_id],references:[id],onDelete:Restrict)
  next_versions       RegulationVersion[] @relation("VersionChain")
  previous_events     ChangeEvent[] @relation("EventPrevious")
  current_event       ChangeEvent? @relation("EventCurrent")
  previous_for        Regulation[]       @relation("RegulationPrevious")
  change_detected     String             @default("") // supplied by a future importer, no detection engine in Phase 2
  created_at          DateTime           @default(now()) @db.Timestamptz(3)
  @@unique([regulation_id,version_name])
  @@index([detected_at])
  @@index([content_hash])
  @@map("regulation_versions")
}
model SyncLog {
  id              String     @id @default(cuid())
  job_id          String?
  job             SyncJob? @relation(fields:[job_id],references:[id],onDelete:SetNull)
  error_kind      String?
  source_id       String
  source          Source     @relation(fields:[source_id],references:[id],onDelete:Restrict)
  started_at      DateTime   @db.Timestamptz(3)
  finished_at     DateTime?  @db.Timestamptz(3)
  status          SyncStatus
  records_found   Int        @default(0)
  records_new     Int        @default(0)
  records_updated Int        @default(0)
  records_failed  Int        @default(0)
  error_message   String?
  is_mock         Boolean    @default(false)
  created_at      DateTime   @default(now()) @db.Timestamptz(3)
  @@index([source_id, started_at(sort: Desc)])
  @@index([job_id])
  @@map("sync_logs")
}
model Watchlist {
  id                 String       @id @default(cuid())
  name               String
  description        String       @default("")
  regulators         Agency[]     @default([])
  categories         String[]     @default([])
  subcategories      String[]     @default([])
  product_types      String[]     @default([])
  development_stages String[]     @default([])
  document_types     DocumentType[] @default([])
  keywords           String[]     @default([])
  importance_levels  Importance[] @default([])
  country_or_regions String[] @default([])
  affected_departments String[] @default([])
  statuses RegulationStatus[] @default([])
  change_types String[] @default([])
  minimum_severity Importance?
  matches WatchlistMatch[]
  notifications NotificationEvent[]
  enabled            Boolean      @default(true)
  created_at         DateTime     @default(now()) @db.Timestamptz(3)
  updated_at         DateTime     @updatedAt @db.Timestamptz(3)
  @@index([enabled])
  @@index([regulators], type: Gin)
  @@map("watchlists")
}

model ChangeEvent {
  watchlist_matches WatchlistMatch[]
  notifications NotificationEvent[]
  id String @id @default(cuid())
  regulation_id String
  regulation Regulation @relation(fields:[regulation_id], references:[id], onDelete:Restrict)
  previous_version_id String?
  previous_version RegulationVersion? @relation("EventPrevious",fields:[previous_version_id],references:[id],onDelete:Restrict)
  current_version_id String @unique
  current_version RegulationVersion @relation("EventCurrent",fields:[current_version_id],references:[id],onDelete:Restrict)
  detected_at DateTime @default(now()) @db.Timestamptz(3)
  change_types String[]
  changed_fields Json
  sections Json
  change_summary String
  severity Importance
  @@index([regulation_id,detected_at(sort:Desc)])
  @@index([detected_at(sort:Desc)])
  @@map("change_events")
}

model WatchlistMatch {
  id String @id @default(cuid())
  watchlist_id String
  watchlist Watchlist @relation(fields:[watchlist_id], references:[id], onDelete:Cascade)
  regulation_id String
  regulation Regulation @relation(fields:[regulation_id],references:[id],onDelete:Restrict)
  change_event_id String?
  change_event ChangeEvent? @relation(fields:[change_event_id],references:[id],onDelete:Restrict)
  matched_at DateTime @default(now()) @db.Timestamptz(3)
  detected_at DateTime @db.Timestamptz(3)
  match_type String
  reasons Json
  dedupe_key String @unique
  @@index([watchlist_id, detected_at])
  @@map("watchlist_matches")
}
model NotificationEvent {
  id String @id @default(cuid())
  created_at DateTime @default(now()) @db.Timestamptz(3)
  regulation_id String?
  regulation Regulation? @relation(fields:[regulation_id],references:[id],onDelete:Restrict)
  change_event_id String?
  change_event ChangeEvent? @relation(fields:[change_event_id],references:[id],onDelete:Restrict)
  watchlist_id String?
  watchlist Watchlist? @relation(fields:[watchlist_id], references:[id], onDelete:SetNull)
  notification_type String
  title String
  message String
  regulator String?
  change_types String[] @default([])
  severity Importance
  channel String @default("IN_APP")
  delivery_status String @default("PENDING")
  delivered_at DateTime? @db.Timestamptz(3)
  failure_reason String?
  dedupe_key String @unique
  read_at DateTime? @db.Timestamptz(3)
  @@index([read_at,created_at])
  @@index([watchlist_id])
  @@map("notification_events")
}
model DigestSettings {
  id String @id @default("workspace")
  digest_enabled Boolean @default(true)
  digest_time String @default("08:00")
  timezone String @default("Asia/Shanghai")
  @@map("digest_settings")
}
model DailyDigest {
  id String @id @default(cuid())
  digest_date String @unique
  timezone String
  window_start DateTime @db.Timestamptz(3)
  window_end DateTime @db.Timestamptz(3)
  generated_at DateTime @default(now()) @db.Timestamptz(3)
  summary Json
  @@map("daily_digests")
}
model SourceHealthCheckpoint {
  source_id String @id
  status String
  revision Int @default(0)
  @@map("source_health_checkpoints")
}
